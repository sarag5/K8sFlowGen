{
    "name": "k8s-flowchart-generator",
    "displayName": "Kubernetes Flowchart Generator",
    "description": "Generate flowcharts from Kubernetes YAML files",
    "version": "0.0.1",
    "engines": {
      "vscode": "^1.60.0"
    },
    "categories": [
      "Visualization"
    ],
    "activationEvents": [
      "onLanguage:yaml"
    ],
    "main": "./out/extension.js",
    "contributes": {
      "commands": [
        {
          "command": "k8s-flowchart-generator.generateFlowchart",
          "title": "Generate K8s Flowchart"
        }
      ]
    },
    "scripts": {
      "vscode:prepublish": "npm run compile",
      "compile": "tsc -p ./",
      "watch": "tsc -watch -p ./",
      "pretest": "npm run compile && npm run lint",
      "lint": "eslint src --ext ts",
      "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
      "@types/vscode": "^1.60.0",
      "@types/node": "14.x",
      "@typescript-eslint/eslint-plugin": "^8.46.4",
      "@typescript-eslint/parser": "^8.46.4",
      "eslint": "^9.39.1",
      "typescript": "^4.3.2"
    }
  }